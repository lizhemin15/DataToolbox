{
  "id": "data-table",
  "name": "数据表格",
  "category": "table",
  "icon": "📋",
  "description": "可排序、可筛选、可分页的数据表格",
  "version": "1.0.0",
  "dependencies": [],
  "config_schema": {
    "title": {
      "type": "string",
      "label": "表格标题",
      "default": "数据列表",
      "required": false
    },
    "data_source": {
      "type": "api_url",
      "label": "数据接口",
      "default": "",
      "required": true
    },
    "columns": {
      "type": "list",
      "label": "列定义",
      "item_schema": {
        "field": { "type": "string", "label": "字段名" },
        "label": { "type": "string", "label": "显示名" },
        "width": { "type": "string", "label": "列宽", "default": "auto" },
        "align": { "type": "select", "label": "对齐", "default": "left", "options": ["left", "center", "right"] },
        "sortable": { "type": "boolean", "label": "可排序", "default": false },
        "render": { "type": "select", "label": "渲染方式", "default": "text", "options": ["text", "number", "percent", "tag", "link"] }
      },
      "default": [],
      "required": true
    },
    "page_size": {
      "type": "number",
      "label": "每页条数",
      "default": 20,
      "min": 5,
      "max": 100
    },
    "show_search": {
      "type": "boolean",
      "label": "显示搜索",
      "default": true
    },
    "show_export": {
      "type": "boolean",
      "label": "显示导出",
      "default": false
    },
    "stripe": {
      "type": "boolean",
      "label": "斑马纹",
      "default": true
    }
  }
}