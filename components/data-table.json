{
  "id": "data-table",
  "name": "数据表格",
  "category": "atom",
  "icon": "TABLE",
  "description": "轻量数据表格，支持排序、斑马纹、固定表头",
  "version": "2.0.0",
  "dependencies": [],
  "min_w": 3,
  "min_h": 3,
  "config_schema": {
    "title": {
      "type": "string",
      "label": "标题",
      "default": "",
      "required": false
    },
    "data_source": {
      "type": "api_url",
      "label": "数据接口",
      "default": "",
      "required": false,
      "hint": "返回 {columns:[{key,title}], rows:[{...}]}"
    },
    "columns": {
      "type": "json",
      "label": "列定义",
      "default": [{"key":"rank","title":"排名"},{"key":"name","title":"名称"},{"key":"value","title":"数值"}],
      "required": false
    },
    "rows": {
      "type": "json",
      "label": "行数据",
      "default": [
        {"rank":1,"name":"北京","value":"12,580"},
        {"rank":2,"name":"上海","value":"11,920"},
        {"rank":3,"name":"深圳","value":"9,340"},
        {"rank":4,"name":"广州","value":"8,760"},
        {"rank":5,"name":"杭州","value":"6,520"}
      ],
      "required": false
    },
    "striped": {
      "type": "boolean",
      "label": "斑马纹",
      "default": true
    },
    "dense": {
      "type": "boolean",
      "label": "紧凑模式",
      "default": false
    },
    "max_height": {
      "type": "number",
      "label": "最大高度(px)",
      "default": 0,
      "min": 0,
      "hint": "0=自适应, >0 时固定表头滚动"
    }
  }
}
