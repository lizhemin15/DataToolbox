{
  "id": "chart-pie",
  "name": "饼图",
  "category": "chart",
  "icon": "🥧",
  "description": "饼图/环形图，支持多维度占比展示",
  "version": "1.0.0",
  "dependencies": ["echarts"],
  "config_schema": {
    "title": {
      "type": "string",
      "label": "图表标题",
      "default": "占比分析",
      "required": false
    },
    "data_source": {
      "type": "api_url",
      "label": "数据接口",
      "default": "",
      "required": true
    },
    "name_field": {
      "type": "string",
      "label": "名称字段",
      "default": "",
      "required": true
    },
    "value_field": {
      "type": "string",
      "label": "数值字段",
      "default": "",
      "required": true
    },
    "ring": {
      "type": "boolean",
      "label": "环形图",
      "default": false
    },
    "ring_width": {
      "type": "number",
      "label": "环宽(%)",
      "default": 40,
      "min": 20,
      "max": 70
    },
    "show_label": {
      "type": "boolean",
      "label": "显示标签",
      "default": true
    },
    "colors": {
      "type": "color_list",
      "label": "配色",
      "default": ["#4F46E5", "#10B981", "#F59E0B", "#EF4444", "#8B5CF6", "#EC4899", "#06B6D4"]
    },
    "height": {
      "type": "number",
      "label": "图表高度(px)",
      "default": 400
    }
  }
}