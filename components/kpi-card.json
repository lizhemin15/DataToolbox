{
  "id": "kpi-card",
  "name": "KPI 卡片",
  "category": "atom",
  "icon": "KPI",
  "description": "单个数值指标卡片，支持标题、数值、趋势箭头、迷你趋势图",
  "version": "2.0.0",
  "dependencies": [],
  "min_w": 2,
  "min_h": 2,
  "config_schema": {
    "title": {
      "type": "string",
      "label": "标题",
      "default": "总销售额",
      "required": false
    },
    "value": {
      "type": "string",
      "label": "数值",
      "default": "¥ 128.5万",
      "required": true
    },
    "prefix": {
      "type": "string",
      "label": "前缀",
      "default": "",
      "required": false
    },
    "suffix": {
      "type": "string",
      "label": "后缀",
      "default": "",
      "required": false
    },
    "trend": {
      "type": "select",
      "label": "趋势",
      "default": "up",
      "options": ["up", "down", "flat", "none"]
    },
    "trend_value": {
      "type": "string",
      "label": "趋势值",
      "default": "12.5%",
      "required": false
    },
    "sparkline_data": {
      "type": "json",
      "label": "迷你趋势图数据",
      "default": [],
      "required": false,
      "hint": "[10, 20, 15, 30, 25, 35, 28]"
    },
    "accent": {
      "type": "color",
      "label": "强调色",
      "default": "",
      "required": false,
      "hint": "留空使用主题默认色"
    }
  }
}
