{
  "id": "chart-line",
  "name": "折线图",
  "category": "chart",
  "icon": "📈",
  "description": "折线图/趋势图，支持多系列、平滑曲线、面积填充",
  "version": "1.0.0",
  "dependencies": ["echarts"],
  "config_schema": {
    "title": {
      "type": "string",
      "label": "图表标题",
      "default": "趋势分析",
      "required": false
    },
    "data_source": {
      "type": "api_url",
      "label": "数据接口",
      "default": "",
      "required": true
    },
    "x_field": {
      "type": "string",
      "label": "X轴字段(时间/类别)",
      "default": "",
      "required": true
    },
    "y_fields": {
      "type": "string_list",
      "label": "Y轴字段",
      "default": [],
      "required": true
    },
    "smooth": {
      "type": "boolean",
      "label": "平滑曲线",
      "default": true
    },
    "area_fill": {
      "type": "boolean",
      "label": "面积填充",
      "default": false
    },
    "colors": {
      "type": "color_list",
      "label": "系列颜色",
      "default": ["#4F46E5", "#10B981", "#F59E0B"]
    },
    "height": {
      "type": "number",
      "label": "图表高度(px)",
      "default": 400
    }
  }
}