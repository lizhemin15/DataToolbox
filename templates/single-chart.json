{
  "id": "single-chart",
  "name": "单图表展示",
  "description": "展示单个图表，支持柱状图/折线图/饼图/面积图，适合嵌入或简单展示",
  "category": "single",
  "icon": "📉",
  "tags": ["图表", "可视化", "单图"],
  "required_tables": {
    "data": {
      "description": "图表数据表",
      "required_columns": ["name", "value"],
      "optional_columns": ["category", "date", "target"]
    }
  },
  "default_config": {
    "title": "数据图表",
    "design_direction": "minimal",
    "primary_color": "#4F46E5"
  },
  "chart_variants": {
    "bar": {
      "description": "柱状图 - 适合分类对比",
      "component_id": "chart-bar",
      "config": {
        "data_source": "{{TABLE_API:data}}?group_by=name&select=name,sum(value)&order_by=sum_value:desc",
        "x_field": "name",
        "y_fields": ["sum_value"],
        "height": 400
      }
    },
    "line": {
      "description": "折线图 - 适合趋势展示",
      "component_id": "chart-line",
      "config": {
        "data_source": "{{TABLE_API:data}}?order_by=date&select=date,sum(value)&group_by=date",
        "x_field": "date",
        "y_fields": ["sum_value"],
        "height": 400
      }
    },
    "pie": {
      "description": "饼图 - 适合占比分析",
      "component_id": "chart-pie",
      "config": {
        "data_source": "{{TABLE_API:data}}?group_by=category&select=category,sum(value)",
        "name_field": "category",
        "value_field": "sum_value",
        "height": 400
      }
    },
    "area": {
      "description": "面积图 - 适合累积趋势",
      "component_id": "chart-area",
      "config": {
        "data_source": "{{TABLE_API:data}}?order_by=date&select=date,sum(value)&group_by=date",
        "x_field": "date",
        "y_fields": ["sum_value"],
        "height": 400
      }
    }
  }
}
